# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local (it is already in .gitignore) and never paste keys into code.

# MongoDB Atlas connection string (free M0 cluster).
# Example shape: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/voicecrm?retryWrites=true&w=majority
MONGODB_URI=
# Groq API key (free tier) from https://console.groq.com/keys
GROQ_API_KEY=

# Which Groq model answers questions.
GROQ_MODEL=openai/gpt-oss-20b

# Optional: lower thinking time for faster voice replies (low | medium | high).
# Leave empty if your model rejects it.
GROQ_REASONING_EFFORT=
